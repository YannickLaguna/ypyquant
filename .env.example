# ── Base de datos — Supabase (Postgres) ───────────────────────
# Pooler (transaction mode, port 6543) — usar para scripts/notebooks
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-3.pooler.supabase.com:6543/postgres
DATABASE_TYPE=postgresql
SUPABASE_URL=https://<project-ref>.supabase.co

# ── Data API Keys ─────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
TWELVE_DATA_API_KEY=your_twelve_data_key
FINNHUB_API_KEY=your_finnhub_key

# ── Config ────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
USE_PROXIES=false
PROXY_ROTATION_ENABLED=false
MIN_HISTORICAL_DATE=1970-01-01
CACHE_ENABLED=True
CACHE_TTL=3600

# ── Paper trading (pipelines/paper_trading): claves de las cuentas PAPER de Alpaca ──
# Una cuenta = un PERFIL con nombre (mayúsculas, dígitos y _): ALPACA_<PERFIL>_API_KEY / ALPACA_<PERFIL>_SECRET_KEY.
# Hasta 3 cuentas activas a la vez (límite blando). Solo claves de cuentas PAPER; nunca se muestran en la web ni en los logs.
ALPACA_PERFILES=PERFIL_1,PERFIL_2,PERFIL_3
ALPACA_PERFIL_1_API_KEY=your_alpaca_paper_key_1
ALPACA_PERFIL_1_SECRET_KEY=your_alpaca_paper_secret_1
ALPACA_PERFIL_2_API_KEY=your_alpaca_paper_key_2
ALPACA_PERFIL_2_SECRET_KEY=your_alpaca_paper_secret_2
ALPACA_PERFIL_3_API_KEY=your_alpaca_paper_key_3
ALPACA_PERFIL_3_SECRET_KEY=your_alpaca_paper_secret_3
# Opcional por perfil: declara que la cuenta es de MARGEN (apalancamiento hasta 2x y ventas en corto). Sin la variable, las
# recetas apalancadas o largo-corto no se pueden vincular. El bot lo comprueba además contra la cuenta real (multiplier).
# ALPACA_PERFIL_1_MARGEN=1
# Perfil DEFECTO (compatibilidad con el bot anterior; opcional si usas perfiles con nombre):
# ALPACA_API_KEY=your_alpaca_paper_key
# ALPACA_SECRET_KEY=your_alpaca_paper_secret
NAUTILUS_POLL_INTERVAL=60
# Mínimo de días naturales de historia; en modo registro el bot descarga más si la estrategia lo necesita
NAUTILUS_LOOKBACK_DAYS=252
